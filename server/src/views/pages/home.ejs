<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1800&q=75"
      alt=""
      width="1800"
      height="1200"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-veil"></div>
  </div>
  <div class="container hero-content reveal">
    <p class="eyebrow"><%= settings.clinicName || 'Aurelia Dental' %></p>
    <h1><%= settings.heroTitle || 'Quiet luxury in modern dentistry' %></h1>
    <p class="lead">
      <%= settings.heroSubtitle || 'A refined clinical experience with personal treatment plans, digital diagnostics, and calm, considered care.' %>
    </p>
    <div class="hero-actions">
      <a class="btn btn-accent" href="/book">Book Appointment</a>
      <a class="btn btn-light" href="/treatments">Explore Treatments</a>
    </div>
  </div>
</section>

<section class="trust-strip" aria-label="Clinic highlights">
  <div class="container trust-grid">
    <div class="trust-item reveal">
      <strong>18+</strong>
      <span>Years of clinical excellence</span>
    </div>
    <div class="trust-item reveal">
      <strong>12k</strong>
      <span>Happy patients cared for</span>
    </div>
    <div class="trust-item reveal">
      <strong>25k</strong>
      <span>Treatments completed</span>
    </div>
    <div class="trust-item reveal">
      <strong><%= doctors.length || 4 %></strong>
      <span>Expert dentists</span>
    </div>
  </div>
</section>

<section class="section" id="treatments">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Treatments</p>
      <h2>Precision care for every smile</h2>
      <p class="lead">
        Explore our active treatments, curated by the clinic team and updated live from the practice database.
      </p>
    </div>

    <% if (!services.length) { %>
      <p class="empty-note reveal">Treatments will appear here once added in the admin panel.</p>
    <% } else { %>
      <div class="services-grid">
        <% services.forEach(function(service) { %>
          <article class="service-card reveal" id="service-<%= service.id %>">
            <div class="service-card__media">
              <% if (service.image) { %>
                <img src="<%= service.image %>" alt="<%= service.title %>" loading="lazy" decoding="async" width="720" height="540" />
              <% } else { %>
                <div class="media-fallback"></div>
              <% } %>
            </div>
            <div class="service-card__body">
              <h3><%= service.title %></h3>
              <p><%= service.description %></p>
              <div class="meta-row">
                <span><%= service.duration %> min</span>
                <span>From <%= helpers.money(service.price) %></span>
              </div>
              <a class="text-link" href="/treatments/<%= service.slug %>">Learn more</a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-soft" id="dentists">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Dentists</p>
      <h2>Meet your clinical team</h2>
      <p class="lead">Experienced clinicians with transparent availability you can book online.</p>
    </div>

    <% if (!doctors.length) { %>
      <p class="empty-note reveal">Dentists will appear here once added in the admin panel.</p>
    <% } else { %>
      <div class="doctors-grid">
        <% doctors.forEach(function(doctor) { %>
          <article class="doctor-card reveal">
            <div class="doctor-media">
              <% if (doctor.image) { %>
                <img src="<%= doctor.image %>" alt="<%= doctor.name %>" loading="lazy" decoding="async" width="640" height="800" />
              <% } else { %>
                <div class="media-fallback doctor-fallback"></div>
              <% } %>
            </div>
            <div class="doctor-card__body">
              <h3><%= doctor.name %></h3>
              <p class="doctor-spec"><%= doctor.specialization || 'General Dentistry' %></p>
              <p class="muted">
                <%= doctor.qualification || 'DDS' %><% if (doctor.experience != null) { %> · <%= doctor.experience %> years experience<% } %>
              </p>
              <p class="doctor-bio"><%= doctor.bio || 'Dedicated to calm, precise dental care with a patient-first approach.' %></p>
              <% if (doctor.availabilities && doctor.availabilities.length) { %>
                <p class="availability-preview">
                  Available:
                  <%= doctor.availabilities.map(function(a){ return helpers.formatDay(a.day); }).join(', ') %>
                </p>
              <% } %>
              <a class="btn btn-dark" href="<%= helpers.doctorPath(doctor) %>">View profile</a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section" id="journey">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Patient Journey</p>
      <h2>A clear path from first visit to aftercare</h2>
      <p class="lead">Every stage is designed to feel considered, transparent, and reassuring.</p>
    </div>
    <ol class="journey-list">
      <li class="reveal">
        <strong>01 Consultation</strong>
        <span>We listen carefully, assess your oral health, and understand the smile you want to achieve.</span>
      </li>
      <li class="reveal">
        <strong>02 Treatment planning</strong>
        <span>Receive a clear plan with timing, options, and investment — never rushed, always explained.</span>
      </li>
      <li class="reveal">
        <strong>03 Procedure</strong>
        <span>Precise clinical care in a calm environment, supported by digital diagnostics and modern equipment.</span>
      </li>
      <li class="reveal">
        <strong>04 Aftercare</strong>
        <span>Personal recovery guidance, follow-up reviews, and ongoing support for lasting results.</span>
      </li>
    </ol>
  </div>
</section>

<section class="section section-ink" id="technology">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Technology</p>
      <h2>Modern dentistry, gently delivered</h2>
      <p class="lead">Digital tools that improve accuracy, comfort, and predictability at every appointment.</p>
    </div>
    <div class="tech-grid">
      <article class="tech-card reveal">
        <div class="tech-icon">01</div>
        <h3>Digital scanning</h3>
        <p>Precise digital impressions without messy trays for clearer planning and faster turnaround.</p>
      </article>
      <article class="tech-card reveal">
        <div class="tech-icon">02</div>
        <h3>3D imaging</h3>
        <p>Detailed visualization for implants, complex restorative work, and confident clinical decisions.</p>
      </article>
      <article class="tech-card reveal">
        <div class="tech-icon">03</div>
        <h3>Modern equipment</h3>
        <p>Contemporary clinical technology throughout the practice for efficient, refined care.</p>
      </article>
      <article class="tech-card reveal">
        <div class="tech-icon">04</div>
        <h3>Comfort-first rooms</h3>
        <p>Quiet suites, thoughtful pacing, and an environment designed to put you at ease.</p>
      </article>
    </div>
  </div>
</section>

<section class="section" id="gallery">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Smile Gallery</p>
      <h2>Before &amp; after transformations</h2>
      <p class="lead">Real patient outcomes curated and published by the clinic team.</p>
    </div>

    <% if (!gallery.length) { %>
      <p class="empty-note reveal">Published smile cases will appear here from the admin gallery.</p>
    <% } else { %>
      <div class="gallery-grid">
        <% gallery.forEach(function(item) { %>
          <article class="gallery-card reveal">
            <div class="gallery-images">
              <figure>
                <img src="<%= item.beforeImage %>" alt="<%= item.treatment %> before" loading="lazy" decoding="async" width="560" height="420" />
                <figcaption>Before</figcaption>
              </figure>
              <figure>
                <img src="<%= item.afterImage %>" alt="<%= item.treatment %> after" loading="lazy" decoding="async" width="560" height="420" />
                <figcaption>After</figcaption>
              </figure>
            </div>
            <h3><%= item.treatment %></h3>
            <% if (item.caption) { %><p class="muted"><%= item.caption %></p><% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-soft" id="testimonials">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Testimonials</p>
      <h2>Stories from our patients</h2>
      <p class="lead">Genuine reflections from people who trusted Aurelia with their care.</p>
    </div>
    <% if (!testimonials.length) { %>
      <p class="empty-note reveal">Approved reviews will appear here from the admin panel.</p>
    <% } else { %>
      <div class="testimonials-grid">
        <% testimonials.forEach(function(item) { %>
          <blockquote class="testimonial reveal">
            <p>“<%= item.review %>”</p>
            <footer>
              <cite><%= item.patientName %></cite>
              <span class="stars" aria-label="<%= item.rating %> out of 5"><%= '★'.repeat(item.rating || 5) %></span>
            </footer>
          </blockquote>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section" id="membership">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Membership</p>
      <h2>Plans for continuous dental wellness</h2>
      <p class="lead">Membership options designed for prevention, priority access, and lasting oral health.</p>
    </div>
    <% if (!memberships.length) { %>
      <p class="empty-note reveal">Membership plans will appear once created in admin.</p>
    <% } else { %>
      <div class="membership-grid<%= memberships.length === 2 ? ' membership-grid--duo' : memberships.length === 1 ? ' membership-grid--solo' : '' %>">
        <% memberships.forEach(function(plan, index) { %>
          <% const featured = memberships.length === 1 ? true : index === 1; %>
          <article class="membership-card<%= featured ? ' featured' : '' %> reveal">
            <div class="membership-card__top">
              <% if (featured) { %>
                <span class="membership-card__badge">Most chosen</span>
              <% } %>
              <h3><%= plan.name %></h3>
              <p class="price">
                <%= helpers.money(plan.price) %><small>/<%= String(plan.billingCycle || '').toLowerCase() %></small>
              </p>
              <% if (plan.description) { %><p class="membership-card__desc"><%= plan.description %></p><% } %>
            </div>
            <ul class="membership-card__benefits">
              <% (plan.benefits || []).forEach(function(benefit) { %>
                <li><%= benefit %></li>
              <% }) %>
            </ul>
            <a class="btn <%= featured ? 'btn-accent' : 'btn-dark' %> membership-card__cta" href="/membership#plan-<%= plan.id %>">View plan details</a>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-soft" id="insurance">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Insurance</p>
      <h2>Clear support for covered care</h2>
      <p class="lead">
        We work with major dental insurers and help verify your benefits before treatment begins.
      </p>
    </div>
    <% if (!insurance.length) { %>
      <p class="empty-note reveal">Insurance providers will appear once added in admin.</p>
    <% } else { %>
      <div class="simple-grid">
        <% insurance.forEach(function(item) { %>
          <article class="plain-item reveal">
            <h3><%= item.name %></h3>
            <p><%= item.details %></p>
            <% if (item.acceptedPlans && item.acceptedPlans.length) { %>
              <p class="muted small">Accepted plans: <%= item.acceptedPlans.join(', ') %></p>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
    <div class="contact-actions reveal" style="margin-top: 1.75rem;">
      <a class="btn btn-dark" href="/insurance">Learn about insurance</a>
      <a class="btn btn-light-dark" href="/book">Ask during booking</a>
    </div>
  </div>
</section>

<section class="section" id="faq">
  <div class="container narrow">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">FAQ</p>
      <h2>Common questions</h2>
      <p class="lead">Answers to help you feel prepared before your first visit.</p>
    </div>
    <% if (!faqs.length) { %>
      <p class="empty-note reveal">FAQs will appear once added in the website CMS.</p>
    <% } else { %>
      <div class="faq-list">
        <% faqs.forEach(function(faq, index) { %>
          <details class="faq-item reveal" <%= index === 0 ? 'open' : '' %>>
            <summary><%= faq.question %></summary>
            <p><%= faq.answer %></p>
          </details>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="cta-band">
  <div class="container cta-inner reveal">
    <h2>Begin your smile journey</h2>
    <p>Choose a treatment, select your dentist, and reserve a time that suits you.</p>
    <a class="btn btn-accent" href="/book">Book an appointment</a>
  </div>
</section>

<section class="section" id="contact">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Contact</p>
      <h2>Visit or send a message</h2>
      <p class="lead">Reach the clinic team for enquiries, treatment questions, or appointment support.</p>
    </div>

    <div class="contact-layout">
      <div class="reveal">
        <h3 style="font-size: 1.8rem; margin-bottom: 0.75rem;">Clinic details</h3>
        <p class="lead" style="margin-top: 0;"><%= settings.address || '214 Harbor Lane, Suite 120' %></p>
        <% if (settings.phone) { %>
          <p><a href="tel:<%= String(settings.phone).replace(/\s+/g, '') %>"><%= settings.phone %></a></p>
        <% } %>
        <% if (settings.email) { %>
          <p><a href="mailto:<%= settings.email %>"><%= settings.email %></a></p>
        <% } %>
        <% if (settings.openingHours) { %>
          <ul class="hours-list">
            <% Object.entries(settings.openingHours).forEach(function([day, hours]) { %>
              <li><span><%= day %></span><span><%= hours %></span></li>
            <% }) %>
          </ul>
        <% } %>
        <div class="contact-actions">
          <a class="btn btn-accent" href="/book">Book Appointment</a>
        </div>

        <div class="map-panel" style="margin-top: 1.5rem;">
          <% if (settings.mapEmbedUrl) { %>
            <iframe
              src="<%= settings.mapEmbedUrl %>"
              title="Clinic map"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          <% } else { %>
            <div class="map-placeholder">
              <div>
                <p class="eyebrow" style="margin-bottom: 0.5rem;">Location</p>
                <h3 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Harbor Lane clinic</h3>
                <p>Map embed can be added in admin settings. Until then, visit us at the address listed.</p>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <div class="contact-form-card reveal">
        <h3>Send an enquiry</h3>
        <p class="muted">We typically respond within one business day.</p>
        <form id="contact-form" class="contact-form" novalidate>
          <label class="field">
            <span>Name</span>
            <input type="text" name="name" required maxlength="120" autocomplete="name" placeholder="Your full name" />
          </label>
          <div class="form-grid-2">
            <label class="field">
              <span>Email</span>
              <input type="email" name="email" required maxlength="254" autocomplete="email" placeholder="you@email.com" />
            </label>
            <label class="field">
              <span>Phone</span>
              <input type="tel" name="phone" required maxlength="40" autocomplete="tel" placeholder="+1 555 0100" />
            </label>
          </div>
          <label class="field">
            <span>Subject</span>
            <input type="text" name="subject" required maxlength="160" placeholder="How can we help?" />
          </label>
          <label class="field">
            <span>Message</span>
            <textarea name="message" required maxlength="5000" rows="5" placeholder="Share a few details about your enquiry."></textarea>
          </label>
          <p class="form-error" id="contact-error" role="alert" aria-live="assertive" hidden></p>
          <p class="form-success" id="contact-success" role="status" aria-live="polite" hidden></p>
          <button type="submit" class="btn btn-dark" id="contact-submit">Send message</button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
