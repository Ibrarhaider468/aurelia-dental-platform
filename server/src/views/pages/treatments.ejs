<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Treatments</p>
    <h1>Care crafted with precision</h1>
    <p class="lead">Explore our full suite of active treatments. Every option is managed in the clinic and shown live from the database.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (!services.length) { %>
      <p class="empty-note reveal">Treatments will appear here once added in the admin panel.</p>
    <% } else { %>
      <div class="treatments-grid card-grid" data-count="<%= services.length %>">
        <% services.forEach(function(service, sIndex) { %>
          <% const serviceSrc = helpers.serviceImage(service, sIndex); %>
          <article class="treatment-item reveal" id="service-<%= service.id %>">
            <div class="treatment-media">
              <img
                src="<%= serviceSrc %>"
                data-fallback="<%= helpers.mediaFallback('service') %>"
                alt="<%= service.title %>"
                loading="lazy"
                decoding="async"
                width="720"
                height="540"
              />
            </div>
            <div class="treatment-body">
              <h3><%= service.title %></h3>
              <p class="card-copy"><%= service.description %></p>
              <div class="meta-row">
                <span><%= service.duration %> min</span>
                <span>From <%= helpers.money(service.price) %></span>
              </div>
              <div class="treatment-actions card-cta">
                <a class="btn btn-dark" href="/treatments/<%= service.slug %>">View details</a>
                <a class="text-link" href="/book?serviceId=<%= service.id %>">Book</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
