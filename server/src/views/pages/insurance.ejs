<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Insurance</p>
    <h1>Accepted providers</h1>
    <p class="lead">
      We partner with leading dental insurers and help verify cover before treatment. Providers and accepted plans are managed by the clinic and shown live.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (!insurance.length) { %>
      <p class="empty-note">No insurance providers yet. Add them in the admin panel.</p>
    <% } else { %>
      <div class="simple-grid card-grid" data-count="<%= insurance.length %>">
        <% insurance.forEach(function(item) { %>
          <article class="plain-item reveal">
            <h3><%= item.name %></h3>
            <p><%= item.details %></p>
            <% if (item.acceptedPlans && item.acceptedPlans.length) { %>
              <p class="muted small">Accepted plans</p>
              <ul class="plan-chips">
                <% item.acceptedPlans.forEach(function(plan) { %>
                  <li><%= plan %></li>
                <% }) %>
              </ul>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>

    <div class="contact-actions contact-actions--section">
      <a class="btn btn-dark" href="/book">Book a consultation</a>
      <a class="btn btn-light-dark" href="/#contact">Ask about cover</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
