<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Dentists</p>
    <h1>Our clinical team</h1>
    <p class="lead">Meet the dentists behind Aurelia — specialists dedicated to calm, precise, patient-first care.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (!doctors.length) { %>
      <p class="empty-note reveal">Dentists will appear here once added in the admin panel.</p>
    <% } else { %>
      <div class="doctors-grid card-grid" data-count="<%= doctors.length %>">
        <% doctors.forEach(function(doctor, dIndex) { %>
          <% const doctorSrc = helpers.doctorImage(doctor, dIndex); %>
          <article class="doctor-card reveal" id="doctor-<%= doctor.id %>">
            <div class="doctor-media">
              <img
                src="<%= doctorSrc %>"
                data-fallback="<%= helpers.mediaFallback('doctor') %>"
                alt="<%= doctor.name %>"
                loading="lazy"
                decoding="async"
                width="640"
                height="800"
              />
            </div>
            <div class="doctor-card__body">
              <div class="doctor-card__copy">
                <h3><%= doctor.name %></h3>
                <p class="doctor-spec"><%= doctor.specialization || 'General Dentistry' %></p>
                <p class="muted doctor-creds">
                  <%= doctor.qualification || 'DDS' %><% if (doctor.experience != null) { %> · <%= doctor.experience %> years experience<% } %>
                </p>
                <p class="doctor-bio"><%= doctor.bio || 'Dedicated to calm, precise dental care.' %></p>
                <% if (doctor.availabilities && doctor.availabilities.length) { %>
                  <p class="availability-preview">
                    Available:
                    <%= doctor.availabilities.map(function(a){ return helpers.formatDay(a.day); }).join(', ') %>
                  </p>
                <% } %>
              </div>
              <div class="treatment-actions card-cta">
                <a class="btn btn-dark" href="<%= helpers.doctorPath(doctor) %>">View profile</a>
                <a class="text-link" href="/book?doctorId=<%= doctor.id %>">Book</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
