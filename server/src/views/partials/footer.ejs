</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand"><%= settings.clinicName || 'Aurelia Dental' %></p>
      <p class="footer-tag">Premium dentistry with quiet confidence — personal care plans, digital precision, and calm clinical spaces.</p>
      <% const social = settings.socialLinks || {}; %>
      <div class="social-links" aria-label="Social links">
        <% if (social.instagram) { %><a href="<%= social.instagram %>" target="_blank" rel="noopener noreferrer">IG</a><% } %>
        <% if (social.facebook) { %><a href="<%= social.facebook %>" target="_blank" rel="noopener noreferrer">FB</a><% } %>
        <% if (social.linkedin) { %><a href="<%= social.linkedin %>" target="_blank" rel="noopener noreferrer">IN</a><% } %>
        <% if (!social.instagram && !social.facebook && !social.linkedin) { %>
          <a href="/#contact" aria-label="Contact">@</a>
        <% } %>
      </div>
    </div>
    <div>
      <h2 class="footer-heading">Explore</h2>
      <div class="footer-links">
        <a href="/treatments">Treatments</a>
        <a href="/dentists">Dentists</a>
        <a href="/membership">Membership</a>
        <a href="/insurance">Insurance</a>
        <a href="/payments">Payments</a>
        <a href="/book">Book</a>
      </div>
    </div>
    <div>
      <h2 class="footer-heading">Services</h2>
      <div class="footer-links">
        <% if (services && services.length) { %>
          <% services.slice(0, 6).forEach(function(service) { %>
            <a href="/treatments#service-<%= service.id %>"><%= service.title %></a>
          <% }) %>
        <% } else { %>
          <a href="/treatments">View all treatments</a>
        <% } %>
      </div>
    </div>
    <div>
      <h2 class="footer-heading">Contact</h2>
      <p><%= settings.address || '214 Harbor Lane, Suite 120' %></p>
      <% if (settings.phone) { %>
        <p><a href="tel:<%= String(settings.phone).replace(/\s+/g, '') %>"><%= settings.phone %></a></p>
      <% } %>
      <% if (settings.email) { %>
        <p><a href="mailto:<%= settings.email %>"><%= settings.email %></a></p>
      <% } %>
      <p style="margin-top: 1rem;"><a class="btn btn-accent" href="/book">Book Appointment</a></p>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© <%= new Date().getFullYear() %> <%= settings.clinicName || 'Aurelia Dental' %>. All rights reserved.</p>
    <p class="footer-credit">Developed by <span>Ibrar Haider</span></p>
    <p><a href="/#faq">FAQ</a> · <a href="/#contact">Visit</a></p>
  </div>
</footer>

<% 
  const whatsappRaw = (settings && settings.whatsappNumber) ? String(settings.whatsappNumber) : '';
  const whatsappDigits = whatsappRaw.replace(/\D/g, '');
%>
<% if (whatsappDigits) { %>
  <a
    class="whatsapp-float"
    href="https://wa.me/<%= whatsappDigits %>"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with us on WhatsApp"
  >
    <span class="whatsapp-float__icon" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor">
        <path d="M16.04 3C9.4 3 4 8.3 4 14.84c0 2.08.55 4.1 1.6 5.89L4 29l8.5-2.22a12.1 12.1 0 0 0 3.54.53h.01c6.64 0 12.04-5.3 12.04-11.84C28.09 8.3 22.68 3 16.04 3zm6.98 16.72c-.3.83-1.74 1.53-2.45 1.63-.63.09-1.43.13-2.31-.14-.53-.17-1.22-.4-2.1-.78-3.7-1.6-6.1-5.33-6.29-5.58-.18-.25-1.52-2.02-1.52-3.85s.96-2.73 1.3-2.93c.34-.2.74-.25.99-.25.25 0 .5 0 .72.01.23.01.54-.09.84.64.3.74 1.03 2.53 1.12 2.71.09.18.15.4.03.64-.12.25-.18.4-.35.62-.18.21-.37.47-.53.63-.18.18-.36.37-.15.73.2.37.9 1.48 1.93 2.4 1.33 1.18 2.45 1.55 2.82 1.73.37.17.58.15.8-.09.21-.25.9-1.05 1.14-1.41.25-.37.49-.3.83-.18.34.12 2.16 1.02 2.53 1.2.37.19.62.28.71.43.09.15.09.88-.2 1.71z"/>
      </svg>
    </span>
    <span class="whatsapp-float__label">WhatsApp</span>
  </a>
<% } %>
<script src="/js/main.js" defer></script>
<script src="/js/media.js" defer></script>
<% if (typeof page !== 'undefined' && page === 'booking') { %>
  <script src="/js/booking.js" defer></script>
<% } %>
<% if (typeof page !== 'undefined' && page === 'membership') { %>
  <script src="/js/membership.js" defer></script>
<% } %>
<% if (typeof page === 'undefined' || page === 'home') { %>
  <script src="/js/contact.js" defer></script>
<% } %>
</body>
</html>
