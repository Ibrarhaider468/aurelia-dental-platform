NODE_ENV=development
PORT=4000

# Public website URL (SEO canonical, sitemap, OG)
PUBLIC_SITE_URL=http://localhost:4000

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://aurelia:aurelia_dev_password@localhost:5432/aurelia_dental?schema=public"

# JWT — use a long random secret in production (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — admin app origin (dev Vite or production admin URL)
CLIENT_URL=http://localhost:5173

# Serve built admin SPA from /admin in production (default true)
SERVE_ADMIN=true

# Set true behind Nginx/Render/Railway/etc. (auto-enabled in production)
TRUST_PROXY=false

# Seed admin (used by prisma/seed.js only)
ADMIN_NAME="Clinic Admin"
ADMIN_EMAIL=admin@aureliadental.com
ADMIN_PASSWORD=Admin123!

# Email (Nodemailer). If unset, emails are logged in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aurelia Dental <noreply@aureliadental.com>"

# Payments (never commit real keys)
PAYMENT_CURRENCY=USD
PAYMENT_SUCCESS_URL=http://localhost:4000/payments?status=success
PAYMENT_CANCEL_URL=http://localhost:4000/payments?status=cancelled
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
