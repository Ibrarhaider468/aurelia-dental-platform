# Local: use Vite proxy (recommended) so login avoids CORS edge cases
VITE_API_URL=/api

# Alternative local: call API directly (requires CORS allowlist for http://localhost:5173)
# VITE_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------------
# Cloudflare Pages / separate admin host (REQUIRED for live login)
# Vite bakes this in at BUILD time. Relative "/api" only works when the API
# is on the SAME origin (e.g. Express serving /admin). On Pages there is no
# /api — set the full backend URL in the Pages dashboard, then Redeploy:
#
#   VITE_API_URL=https://YOUR-API-HOST.com/api
#
# Also set on the API server:
#   CLIENT_URL=https://YOUR-ADMIN.pages.dev
#   CORS_ORIGINS=https://www.your-custom-admin-domain.com   (optional extras)
# ---------------------------------------------------------------------------
